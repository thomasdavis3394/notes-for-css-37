性别: {{user238.gender == "M" ? "男" : "女"}}
状态: {{user238.active ? "激活" : "未激活"}}
注册时间: {{user238.registeredAt}}
最后登录: {{user238?.lastLoginAt ?: '从未登录'}}
用户角色: {{user238.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user238.username !=~ /^test/ ? '正式账号' : '测试账号'}}
个人签名: {{user238?.profile?.signature ?: '这个人很懒，什么都没写'}}


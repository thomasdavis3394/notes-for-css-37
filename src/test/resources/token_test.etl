最后登录: {{user192?.lastLoginAt ?: '从未登录'}}
用户角色: {{user192.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user192.username !=~ /^test/ ? '正式账号' : '测试账号'}}

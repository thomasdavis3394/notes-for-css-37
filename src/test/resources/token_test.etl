最后登录: {{user449?.lastLoginAt ?: '从未登录'}}
用户角色: {{user449.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user449.username !=~ /^test/ ? '正式账号' : '测试账号'}}

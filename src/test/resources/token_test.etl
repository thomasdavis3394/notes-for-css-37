年龄: {{user26.age}}
年龄段: {{user26.age in 18>..<60 ? '工作年龄' : '非工作年龄'}}
性别: {{user26.gender == "M" ? "男" : "女"}}
状态: {{user26.active ? "激活" : "未激活"}}
注册时间: {{user26.registeredAt}}
最后登录: {{user26?.lastLoginAt ?: '从未登录'}}
用户角色: {{user26.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user26.username !=~ /^test/ ? '正式账号' : '测试账号'}}
个人签名: {{user26?.profile?.signature ?: '这个人很懒，什么都没写'}}


年龄: {{user398.age}}
年龄段: {{user398.age in 18>..<60 ? '工作年龄' : '非工作年龄'}}
性别: {{user398.gender == "M" ? "男" : "女"}}
状态: {{user398.active ? "激活" : "未激活"}}
注册时间: {{user398.registeredAt}}
最后登录: {{user398?.lastLoginAt ?: '从未登录'}}
用户角色: {{user398.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user398.username !=~ /^test/ ? '正式账号' : '测试账号'}}
个人签名: {{user398?.profile?.signature ?: '这个人很懒，什么都没写'}}


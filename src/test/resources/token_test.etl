年龄: {{user251.age}}
年龄段: {{user251.age in 18>..<60 ? '工作年龄' : '非工作年龄'}}
性别: {{user251.gender == "M" ? "男" : "女"}}
状态: {{user251.active ? "激活" : "未激活"}}

性别: {{user469.gender == "M" ? "男" : "女"}}
状态: {{user469.active ? "激活" : "未激活"}}
注册时间: {{user469.registeredAt}}
最后登录: {{user469?.lastLoginAt ?: '从未登录'}}
用户角色: {{user469.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user469.username !=~ /^test/ ? '正式账号' : '测试账号'}}

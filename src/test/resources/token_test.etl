{% case 2 }已支付
{% case 3 }配送中
{% case 4 }已完成
{% default }已取消
{/% switch }
订单金额: {{order276.amount}}元
折扣金额: {{order276?.discount ?: 0}}元
实付金额: {{order276.amount - (order276?.discount ?: 0)}}元
订单状态码: {{order276.statusCode !in [0, -1, -2] ? '正常' : '异常'}}


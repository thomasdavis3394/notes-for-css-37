用户ID: {{user44.id}}
用户名: {{user44?.name ?: '匿名用户'}}
邮箱: {{user44?.email}}
邮箱验证: {{user44.email =~ /^[\w.-]+@[\w.-]+\.\w+$/ ? '有效' : '无效'}}
年龄: {{user44.age}}
年龄段: {{user44.age in 18>..<60 ? '工作年龄' : '非工作年龄'}}
性别: {{user44.gender == "M" ? "男" : "女"}}
状态: {{user44.active ? "激活" : "未激活"}}
注册时间: {{user44.registeredAt}}
最后登录: {{user44?.lastLoginAt ?: '从未登录'}}
用户角色: {{user44.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user44.username !=~ /^test/ ? '正式账号' : '测试账号'}}
个人签名: {{user44?.profile?.signature ?: '这个人很懒，什么都没写'}}


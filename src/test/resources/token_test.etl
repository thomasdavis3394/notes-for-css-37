年龄: {{user12.age}}
年龄段: {{user12.age in 18>..<60 ? '工作年龄' : '非工作年龄'}}
性别: {{user12.gender == "M" ? "男" : "女"}}
状态: {{user12.active ? "激活" : "未激活"}}
注册时间: {{user12.registeredAt}}
最后登录: {{user12?.lastLoginAt ?: '从未登录'}}
用户角色: {{user12.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user12.username !=~ /^test/ ? '正式账号' : '测试账号'}}

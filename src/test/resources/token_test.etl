用户ID: {{user475.id}}
用户名: {{user475?.name ?: '匿名用户'}}
邮箱: {{user475?.email}}
邮箱验证: {{user475.email =~ /^[\w.-]+@[\w.-]+\.\w+$/ ? '有效' : '无效'}}
年龄: {{user475.age}}
年龄段: {{user475.age in 18>..<60 ? '工作年龄' : '非工作年龄'}}
性别: {{user475.gender == "M" ? "男" : "女"}}
状态: {{user475.active ? "激活" : "未激活"}}
注册时间: {{user475.registeredAt}}
最后登录: {{user475?.lastLoginAt ?: '从未登录'}}
用户角色: {{user475.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user475.username !=~ /^test/ ? '正式账号' : '测试账号'}}
个人签名: {{user475?.profile?.signature ?: '这个人很懒，什么都没写'}}


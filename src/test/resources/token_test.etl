性别: {{user282.gender == "M" ? "男" : "女"}}
状态: {{user282.active ? "激活" : "未激活"}}
注册时间: {{user282.registeredAt}}
最后登录: {{user282?.lastLoginAt ?: '从未登录'}}
用户角色: {{user282.role in ['admin', 'moderator'] ? '管理员' : '普通用户'}}
账号类型: {{user282.username !=~ /^test/ ? '正式账号' : '测试账号'}}

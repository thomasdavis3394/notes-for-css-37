E2E structured-expressions
{% let score = 75 %}
{% let grade = if (score >= 90) { 'A' } else if (score >= 60) { 'B' } else { 'C' } %}
{assert(grade == 'B')}
if-expr OK
{% let label = if (1 > 2) { 'x' } else { let t = 'multi'; t + '!' } %}
{assert(label == 'multi!')}
{% let deep = if (true) { if (false) { 'no' } else { 'yes' } } else { 'outer' } %}
{assert(deep == 'yes')}
block-value OK
inline: {if (5 > 3) { 'big' } else { 'small' }}
inline-if-expr OK
{% let side = [] %}
{% if (1 < 2) { side.add('ran') } %}
{assert(side == ['ran'])}
standalone-if-expr OK
{% let collected = [] %}
{% for (n in [1, 2, 3]) { collected.add(n * 10) } %}
{assert(collected == [10, 20, 30])}
for-expr OK
{% let indexed = [] %}
{% for (i, n in ['a', 'b']) { indexed.add(i) } %}
{assert(indexed == [0, 1])}
for-expr-index OK
{% let ran = [] %}
{% for (i in 1..3) { ran.add(i * 2) } %}
{assert(ran == [2, 4, 6])}
for-expr-range OK
{% let double = x -> x * 2 %}
{assert(double(21) == 42)}
{% let add = (a, b) -> a + b %}
{assert(add(3, 4) == 7)}
{% let sum3 = (a, b, c) -> a + b + c %}
{assert(sum3(1, 2, 3) == 6)}
{% let answer = () -> 42 %}
{assert(answer() == 42)}
{% let typed = (int a, int b) -> a * b %}
{assert(typed(6, 7) == 42)}
{% let block = (a, b) -> { let s = a + b; return s * 2 } %}
{assert(block(3, 4) == 14)}
{% let factor = 10 %}
{% let scaled = x -> x * factor %}
{assert(scaled(5) == 50)}
{% let apply = (f, v) -> f(v) %}
{assert(apply(double, 21) == 42)}
{% let greet = s -> 'Hello, ' + s %}
{assert(greet('World') == 'Hello, World')}
{assert(double(5) + 10 == 20)}
{% let addA = a -> (b -> a + b) %}
{% let add2 = addA(2) %}
{assert(add2(3) == 5)}
{% let mk = () -> [7, 8] %}
{assert(7 in mk())}
lambda OK

{% arr2[1] += 5 %}
{assert(arr2[1] == 25)}
{% let m2 = {k: 1} %}
{% m2['k'] *= 10 %}
{assert(m2['k'] == 10)}
compound-assign OK
{% let i = 5 %}
{assert(i++ == 5)}
{assert(i == 6)}
{assert(++i == 7)}
{assert(i-- == 7)}
{assert(--i == 5)}
{% let j = 1 %}
{assert(++j * 2 == 4)}
{% let arr = [1, 2] %}
{% arr[0]++ %}
{assert(arr[0] == 2)}
{% let obj = {count: 10} %}
{% obj['count']-- %}
{assert(obj['count'] == 9)}

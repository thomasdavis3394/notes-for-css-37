E2E control-flow
{% let x = 2 %}
{% if x == 1 }one{% else if x == 2 }two{% else }other{/% if }
{assert(x == 2)}
if-elseif OK
{% if x > 1 }{% if x < 3 }nested-ok{/% if }{/% if }
{assert(length('nested-ok') == 9)}
nested-if OK
{% let t = [] %}
{% if 0 }{% t.add('bad') %}{/% if }
{% if '' }{% t.add('bad') %}{/% if }
{% if null }{% t.add('bad') %}{/% if }
{% if [] }{% t.add('bad') %}{/% if }
{% if 1 }{% t.add('one') %}{/% if }
{% if 's' }{% t.add('str') %}{/% if }
{% if [0] }{% t.add('list') %}{/% if }
{assert(t == ['one', 'str', 'list'])}
truthy OK
{% let r = [] %}
{% switch x }
{% case 1 }{% r.add('one') %}
{% case 2 }{% r.add('two') %}
{% case 1 + 2 }{% r.add('three') %}
{% default }{% r.add('other') %}
{/% switch }
{assert(r == ['two'])}
switch OK
{% let s = 'active' %}
{% switch s }
{% case 'active' }{% r.add('A') %}
{% case 'inactive' }{% r.add('I') %}
{/% switch }
{assert(r[-1] == 'A')}
switch-string OK
{% switch 99 }
{% case 1 }{% r.add('bad') %}
{/% switch }
{assert(r == ['two', 'A'])}
switch-no-default OK
{% switch 'a' }
{% case 'a' }{% switch 'b' }
{% case 'b' }{% r.add('ab') %}
{/% switch }{/% switch }
{assert(r[-1] == 'ab')}
switch-nested OK
{% let hits = [] %}
{% for item in ['a', 'b', 'c'] }{% hits.add(item) %}{/% for }
{assert(hits == ['a', 'b', 'c'])}
for-list OK
{% for item in [] }{% hits.add('bad') %}{/% for }
{assert(hits == ['a', 'b', 'c'])}
for-empty OK
{% let idx = [] %}
{% for i, item in ['a', 'b', 'c'] }{% idx.add(i) %}{/% for }
{assert(idx == [0, 1, 2])}
for-index OK
{% let nums = [] %}
{% for i in 1..3 }{% nums.add(i) %}{/% for }
{assert(nums == [1, 2, 3])}
{% for i in 1..<4 }{% nums.add(i) %}{/% for }
{assert(nums == [1, 2, 3, 1, 2, 3])}
{% let lo = 2 %}
{% let hi = 4 %}
{% for i in lo..hi }{% nums.add(i) %}{/% for }
{assert(nums == [1, 2, 3, 1, 2, 3, 2, 3, 4])}
for-range OK
{% let keys = [] %}
{% for k in {a: 1, b: 2}.keySet() }{% keys.add(k) %}{/% for }
{assert(length(keys) == 2)}
{assert('a' in keys && 'b' in keys)}
{% let m = {a: 1, b: 2} %}
{% let total = [0] %}
{% for k in m.keySet() }{% total[0] += m[k] %}{/% for }
{assert(total[0] == 3)}
for-map OK
{% let pairs = [] %}
{% for i in 1..2 }{% for j in 1..2 }{% pairs.add(i * 10 + j) %}{/% for }{/% for }
{assert(pairs == [11, 12, 21, 22])}
{% let quad = [] %}
{% for i, a in ['x', 'y'] }{% for j, b in ['p'] }{% quad.add(i * 10 + j) %}{/% for }{/% for }
{assert(quad == [0, 10])}
for-nested OK
{% let seq = [] %}
{% for let i = 0; i < 5; i++ }{% seq.add(i) %}{/% for }
{assert(seq == [0, 1, 2, 3, 4])}
{% let evens = [] %}
{% for let i = 0; i < 10; i += 2 }{% evens.add(i) %}{/% for }
{assert(evens == [0, 2, 4, 6, 8])}
{% let down = [] %}
{% for let i = 3; i > 0; i-- }{% down.add(i) %}{/% for }
{assert(down == [3, 2, 1])}
{% let inclusive = [] %}
{% for let i = 1; i <= 3; i++ }{% inclusive.add(i) %}{/% for }
{assert(inclusive == [1, 2, 3])}
for-classic OK
{% let p = 1; let q = 2; let pq = p + q %}
{assert(pq == 3)}
{%
  let u = 10
  let v = 20
%}
{assert(u + v == 30)}
let-multi OK
items:{% for item in ['a', 'b', 'c'] } {item}{/% for }
CONTROL-FLOW ALL PASS
